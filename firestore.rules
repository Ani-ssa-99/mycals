rules_version = '2';
// Règles de sécurité de Mycals : chaque membre ne peut modifier que ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Journal sauvegardé et liste de blocage : privés
    match /users/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && str(request.resource.data.name, 1, 40)
        && (!('bio' in request.resource.data) || str(request.resource.data.bio, 0, 160))
        && (!('photo' in request.resource.data) || str(request.resource.data.photo, 0, 200000));
      allow delete: if isMe(uid) || isAdmin();
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.name, 1, 40)
        && str(request.resource.data.text, 1, 1000)
        && request.resource.data.kind in ['conseil', 'sport', 'question', 'progres', 'recette']
        && str(request.resource.data.image, 0, 400000)
        && str(request.resource.data.photo, 0, 200000)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;
      // compteurs de j'aime et de commentaires : +1 ou -1 seulement
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
          ))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1))
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.name, 1, 40)
          && str(request.resource.data.text, 1, 500)
          && str(request.resource.data.photo, 0, 200000)
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid
          || isAdmin());
      }
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
    }
  }
}
